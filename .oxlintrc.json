{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react"],
  "jsPlugins": ["./.oxlint/tailwind-boundary.js"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "typescript/no-explicit-any": "off",
    // Several components initialise browser-only state (age, countdown,
    // stored language) inside an effect on purpose, so the server render
    // and the first client render agree. The rule flags exactly that.
    "react/set-state-in-effect": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    // A file past 500 lines is doing more than one job. Split it into the
    // pieces it is already made of rather than raising this number.
    "max-lines": ["error", { "max": 500 }],
    // Tailwind classes belong in a component under `src/components/` or
    // `src/features/`, so a route or a page composes components rather than
    // styling markup itself. The override below is what exempts those two.
    "boundary/no-tailwind": "error"
  },
  "overrides": [
    {
      "files": ["src/components/**", "src/features/**"],
      "rules": { "boundary/no-tailwind": "off" }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    ".output",
    ".nitro",
    ".tanstack",
    ".vercel",
    "dist",
    "coverage",
    "storybook-static",
    "src/routeTree.gen.ts"
  ]
}
