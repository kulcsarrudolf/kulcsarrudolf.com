{
  "name": "kulcsarrudolf-com",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent || !process.env.npm_config_user_agent.startsWith('yarn/')) { console.error('This project uses Yarn. Please run: yarn install'); process.exit(1); }\"",
    "prepare": "husky",
    "dev": "node scripts/preview-images.ts && vite dev",
    "dev:setup": "node scripts/dev-setup.ts",
    "build": "node scripts/preview-images.ts && vite build",
    "og": "node scripts/preview-images.ts",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --https --ssl-cert .certs/cert.pem --ssl-key .certs/key.pem",
    "build-storybook": "storybook build",
    "deploy": "bash scripts/deploy.sh",
    "docker:dev": "docker compose up",
    "docker:storybook": "docker compose --profile storybook up",
    "docker:prod": "docker compose --profile prod up app --build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-start": "^1.168.50",
    "@vercel/analytics": "^2.0.1",
    "gray-matter": "^4.0.3",
    "markdown-to-jsx": "^7.2.1",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zimme-zoom": "^0.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.2.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "satori": "^0.33.4",
    "storybook": "^10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "resolutions": {
    "brace-expansion": "^2.1.4",
    "cross-spawn": "^7.0.6",
    "flatted": "^3.4.2",
    "gray-matter/js-yaml": "^3.15.2",
    "js-yaml": "^4.3.2",
    "minimatch": "^9.0.7",
    "picomatch": "^2.3.2",
    "postcss": "^8.5.18",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@1.22.22"
}
