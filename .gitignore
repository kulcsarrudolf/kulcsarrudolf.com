# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
.pnp.*

# yarn: the release under .yarn/releases is committed, the rest is generated
/.yarn/*
!/.yarn/releases

# testing
/coverage

# build output (vite + nitro)
/.output/
/.nitro/
/.tanstack/
/dist/

# storybook
/storybook-static/
*storybook.log

# misc
.DS_Store
*.pem

# local dev certificate, written by `yarn dev:setup`
/.certs/

# debug
npm-debug.log*

# local env files
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# editor / agent local config
/.cursor/
.claude/settings.local.json
.claude/*.local.json

# design canvas scratch
/.design/

# social preview cards, rendered by `yarn og` before dev and build
/public/og/
