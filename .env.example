# Copy to .env.local. Client-side variables need the VITE_ prefix.

# Set to "production" to enable Vercel Analytics. Set per environment on Vercel.
VITE_ENV=

# Web3Forms access key used by the contact form.
VITE_WEB3FORMS_ACCESS_KEY=

# Used only by `yarn upload-image`, never by the site; see docs/uploading-images.md. Copy the
# "API environment variable" from the Cloudinary console: cloudinary://<key>:<secret>@<cloud>
CLOUDINARY_URL=
